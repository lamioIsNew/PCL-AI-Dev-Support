<local:MyPageRight
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:PCL" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d" x:Class="PageSetupAI"
    PanScroll="PanBack">
    <local:MyScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" x:Name="PanBack">
        <StackPanel Margin="25,10">
            <local:MyCard Margin="0,15" Title="Java AI 开发（MCP）">
                <StackPanel Margin="25,42,25,22">
                    <TextBlock Text="让 AI 工具连接 PCL - DTA" FontSize="15" FontWeight="Bold" />
                    <TextBlock Margin="0,8,0,0" LineHeight="19" TextWrapping="Wrap" Foreground="{DynamicResource ColorBrushGray2}"
                               Text="该功能将基于 Model Context Protocol（MCP）为 Java 开发提供 AI 辅助能力，例如读取项目结构、分析构建配置、生成或修改代码。&#xa;当前版本仅提供界面入口，具体能力将在后续 TODO 更新后逐步实现。" />
                </StackPanel>
            </local:MyCard>
            <local:MyCard Margin="0,0,0,15" Title="服务配置">
                <Grid Margin="25,42,25,22">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="MCP 服务" Margin="0,0,25,0" />
                    <local:MyCheckBox Grid.Row="0" Grid.Column="1" Height="22" VerticalAlignment="Center" Text="启用 MCP 服务（开发中）" IsEnabled="False" />
                    <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Text="监听端口" Margin="0,12,25,0" />
                    <local:MyTextBox Grid.Row="1" Grid.Column="1" Margin="0,12,0,0" Width="180" HorizontalAlignment="Left" Text="4567" IsEnabled="False" />
                    <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal" Height="35" Margin="0,20,0,0">
                        <local:MyButton x:Name="BtnMcpStart" MinWidth="140" Text="启动服务" Padding="13,0" Margin="0,0,20,0" ColorType="Highlight" />
                        <local:MyButton MinWidth="140" Text="MCP 文档" Padding="13,0" local:CustomEventService.EventType="打开网页" local:CustomEventService.EventData="https://modelcontextprotocol.io/" />
                    </StackPanel>
                </Grid>
            </local:MyCard>
        </StackPanel>
    </local:MyScrollViewer>
</local:MyPageRight>
